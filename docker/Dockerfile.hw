# syntax=docker/dockerfile:1.7
# mighty-hw — the MIGHTY hardware autonomy stack (planner + MPC) as ONE idling
# container whose nodes are docker-exec'd from a HOST tmux session (see
# mighty_hw.sh / compose.hw.yaml).
#
# The image is a pure function of (this checkout, mighty.repos). The build
# context is the mighty repo root; every dependency is cloned INSIDE the build
# from the pins in mighty.repos, filtered to the hardware closure (HW_DEPS).
# Nothing on the host but this checkout is an input — no sibling workspaces, no
# prebuilt tarballs, no host paths. Change a dependency by bumping its pin.
#
# What is deliberately NOT in here (each is owned by another service/host):
#   DLIO            dlio.service (dlio_ws)          -> <ns>/dlio/odom_node/odom, map->odom
#   livox driver    sensors.service                  -> <ns>/livox/{lidar,imu}
#   mapper          elevation_mapping_cupy, OX08 Orin -> <ns>/occ_2d_topic, esdf_2d_topic
#   zenoh router    drive.service                    -> :7447
#   sim repos       gazebo/uav_simulator/livox sim   (BUILD_SIMULATION=OFF)
# Nothing in mighty, mpc or dynus_interfaces links the Livox SDK or driver:
# the only "livox" in mighty is a topic name and a frame-id string.
#
# Stages, ordered so the expensive layers stay cached across mighty edits:
#   deps-src     clone HW_DEPS at their pins   (keyed on mighty.repos ONLY)
#   deps-build   rosdep + colcon the deps      (re-runs only when a pin moves)
#   mighty-build COPY this checkout + colcon   (the layer you iterate on)
#   runtime      exec deps + the install tree  (what ships)
#
# Cloning needs SSH for the private mpc repo (GitLab): build with
#   docker compose -f compose.hw.yaml build --ssh default[=~/.ssh/<key>]
# (make hw-build does this; see Makefile). Public deps clone over https.
#
# In-image workspace path == the rover's host path (/home/swarm/code/mighty_ws)
# so the pane setup line mighty_hw.sh sends is what you would type on the rover.
ARG WS=/home/swarm/code/mighty_ws
# Dependency repos from mighty.repos that the HARDWARE stack needs. Keys must
# match mighty.repos entries; the filter below fails loudly on a typo.
ARG HW_DEPS="dynus_interfaces mpc DecompROS2"

# ---------- deps-src: pinned dependency sources ----------------------------------
FROM ros:humble-ros-base AS deps-src
ARG WS
ARG HW_DEPS
SHELL ["/bin/bash", "-c"]
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        openssh-client python3-vcstool python3-yaml \
    && rm -rf /var/lib/apt/lists/*
COPY mighty.repos /tmp/mighty.repos
# The whole layer is keyed on /tmp/mighty.repos + HW_DEPS: editing mighty
# source never re-clones. --mount=type=ssh forwards the caller's key for
# git@gitlab.com:mit-acl/ugv/ugv_control/mpc.git; the known_hosts scan keeps
# git from prompting. No --shallow: pins are commit SHAs, and these repos are
# small.
RUN --mount=type=ssh \
    mkdir -p -m 0700 ~/.ssh && ssh-keyscan -H github.com gitlab.com >> ~/.ssh/known_hosts 2>/dev/null \
 && mkdir -p ${WS}/src \
 && python3 - "${HW_DEPS}" <<'PY' | vcs import ${WS}/src
import sys, yaml
repos = yaml.safe_load(open('/tmp/mighty.repos'))['repositories']
keep = sys.argv[1].split()
missing = [k for k in keep if k not in repos]
assert not missing, f'HW_DEPS not in mighty.repos: {missing}'
yaml.safe_dump({'repositories': {k: repos[k] for k in keep}}, sys.stdout)
PY

# ---------- deps-build: rosdep + colcon the dependency workspace ----------------
FROM ros:humble-ros-base AS deps-build
ARG WS
SHELL ["/bin/bash", "-c"]
ENV DEBIAN_FRONTEND=noninteractive
WORKDIR ${WS}
COPY --from=deps-src ${WS}/src ${WS}/src
# --skip-keys: ament_python is mpc's buildtool_depend, not a rosdistro key;
# catkin: DecompUtil ships a catkin-era package.xml (buildtool_depend
# catkin) but is a plain CMake project — colcon builds it fine, rosdep cannot
# resolve the key. libeigen3-dev is explicit: decomp_util and mighty
# find_package(Eigen3) without declaring it.
RUN apt-get update && rosdep update \
 && rosdep install -y --ignore-src --from-paths src --skip-keys "catkin ament_python" \
 && apt-get install -y --no-install-recommends libeigen3-dev \
 && rm -rf /var/lib/apt/lists/*
# decomp_util first, on its own: decomp_rviz_plugins find_package()s it
# without declaring the dependency in package.xml, so colcon cannot order
# them in one invocation.
RUN source /opt/ros/humble/setup.bash \
 && colcon build --packages-select decomp_util --cmake-args -DCMAKE_BUILD_TYPE=Release \
 && source install/setup.bash \
 && colcon build --packages-skip decomp_util --cmake-args -DCMAKE_BUILD_TYPE=Release \
 && rm -rf build log

# ---------- mighty-build: this checkout on top of the deps -----------------------
FROM deps-build AS mighty-build
ARG WS
SHELL ["/bin/bash", "-c"]
ENV DEBIAN_FRONTEND=noninteractive
WORKDIR ${WS}
# The manifest alone first, so the apt layer below is keyed on package.xml and
# a source edit re-runs only the colcon layer.
# gazebo_ros/gazebo_plugins are declared <depend>s but only the BUILD_SIMULATION
# targets use them; gazebo_msgs stays (fake_sim links it unconditionally, and it
# is messages only). nlohmann-json3-dev: find_package()ed, not declared.
COPY package.xml ${WS}/src/mighty/package.xml
RUN apt-get update && rosdep update \
 && rosdep install -y --ignore-src --from-paths src --skip-keys "catkin ament_python gazebo_ros gazebo_plugins" \
 && apt-get install -y --no-install-recommends nlohmann-json3-dev \
 && rm -rf /var/lib/apt/lists/*
# Build context = the mighty repo root (compose: context ..). What ships is
# filtered by Dockerfile.hw.dockerignore next to this file.
COPY . ${WS}/src/mighty
RUN source /opt/ros/humble/setup.bash && source install/setup.bash \
 && colcon build --packages-select mighty \
        --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_SIMULATION=OFF -DBUILD_TESTING=OFF \
 && rm -rf build log
# Manifests for the runtime stage's rosdep, with mtimes pinned so the COPY
# --from below (and the apt layer behind it) stays cached across source edits.
RUN mkdir -p /manifests && cd src \
 && find . -name package.xml -exec cp --parents {} /manifests \; \
 && find /manifests -exec touch -d @0 {} +

# ---------- runtime: exec deps + the baked workspace -----------------------------
FROM ros:humble-ros-base
ARG WS
SHELL ["/bin/bash", "-c"]
ENV DEBIAN_FRONTEND=noninteractive
WORKDIR ${WS}
COPY --from=mighty-build /manifests /tmp/manifests
# Exec deps come from the manifests alone. Explicit extras:
#   rmw-zenoh-cpp + zenoh-cpp-vendor  fleet RMW; the vendor is named so a cached
#                                     apt layer cannot pin an older wire library
#   tmux                              the panes are docker execs, but handy inside
# (tf_transformations is imported only by scripts/convert_goal_to_cmd_vel.py,
# which is not an install(PROGRAMS) target and never ships — and its apt
# transforms3d breaks under numpy 2 anyway. Do not add it back blindly.)
RUN apt-get update && rosdep update \
 && rosdep install -y --ignore-src --dependency-types exec --from-paths /tmp/manifests \
        --skip-keys "catkin ament_python gazebo_ros gazebo_plugins" \
 && apt-get install -y --no-install-recommends \
        ros-humble-rmw-zenoh-cpp \
        ros-humble-zenoh-cpp-vendor \
        tmux python3-pip \
 && rm -rf /var/lib/apt/lists/* /tmp/manifests
# mpc_node imports casadi/do_mpc. Pinned to what the rovers ran natively;
# numpy/scipy second so their pins win over do-mpc's resolver.
RUN pip3 install --no-cache-dir casadi==3.6.7 do-mpc==5.1.1 \
 && pip3 install --no-cache-dir numpy==2.2.6 scipy==1.15.3
COPY --from=mighty-build ${WS}/install ${WS}/install
# Interactive shells (docker exec -it ... bash) see the workspace. The panes do
# not rely on this — mighty_hw.sh sends an explicit setup line — but a human
# poking around inside should get the same environment.
RUN printf 'source /opt/ros/humble/setup.bash\nsource %s/install/setup.bash\n' "${WS}" >> /root/.bashrc
# Command comes from compose: the container only idles (`sleep infinity`).
