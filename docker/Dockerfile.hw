# syntax=docker/dockerfile:1.7
# mighty-hw — the MIGHTY hardware autonomy stack (planner + MPC) as ONE idling
# container whose nodes are docker-exec'd from a HOST tmux session (see
# mighty_hw.sh / compose.hw.yaml).
#
# The image is a pure function of (this checkout, mighty.repos). The build
# context is the mighty repo root; every dependency is cloned INSIDE the build
# from the pins in mighty.repos, filtered to the hardware closure (HW_DEPS).
# Nothing on the host but this checkout is an input — no sibling workspaces, no
# prebuilt tarballs, no host paths. Change a dependency by bumping its pin.
#
# What is deliberately NOT in here (each is owned by another service/host):
#   DLIO            dlio.service (dlio_ws)          -> <ns>/dlio/odom_node/odom, map->odom
#   livox driver    sensors.service                  -> <ns>/livox/{lidar,imu}
#   mapper          elevation_mapping_cupy, OX08 Orin -> <ns>/occ_2d_topic, esdf_2d_topic
#   zenoh router    drive.service                    -> :7447
#   sim repos       gazebo/uav_simulator/livox sim   (BUILD_SIMULATION=OFF)
# Nothing in mighty, mpc or dynus_interfaces links the Livox SDK or driver:
# the only "livox" in mighty is a topic name and a frame-id string.
#
# Stages, ordered so the expensive layers stay cached across mighty edits:
#   deps-src     clone HW_DEPS at their pins   (keyed on mighty.repos ONLY)
#   deps-build   rosdep + colcon the deps      (re-runs only when a pin moves)
#   mighty-build COPY this checkout + colcon   (the layer you iterate on)
#   runtime      exec deps + the install tree  (what ships)
#
# Cloning needs SSH for the private mpc repo (GitLab): build with
#   docker compose -f compose.hw.yaml build --ssh default[=~/.ssh/<key>]
# (make hw-build does this; see Makefile). Public deps clone over https.
#
# In-image workspace path == the rover's host path (/home/swarm/code/mighty_ws)
# so the pane setup line mighty_hw.sh sends is what you would type on the rover.
ARG WS=/home/swarm/code/mighty_ws
# ROS distro of every stage. humble = the Red Rover fleet (their drive/sensors/
# dlio images are Humble, and rmw_zenoh does not bridge distros); jazzy = the
# scout (pascal), whose host stack is Jazzy. compose passes MIGHTY_ROS_DISTRO.
# Stages read the base image's own ENV ROS_DISTRO, so this ARG only picks it.
ARG ROS_DISTRO=humble
# Dependency repos from mighty.repos that the HARDWARE stack needs. Keys must
# match mighty.repos entries; the filter below fails loudly on a typo.
ARG HW_DEPS="dynus_interfaces mpc DecompROS2"

# ---------- deps-src: pinned dependency sources ----------------------------------
FROM ros:${ROS_DISTRO}-ros-base AS deps-src
ARG WS
ARG HW_DEPS
SHELL ["/bin/bash", "-c"]
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        openssh-client python3-vcstool python3-yaml \
    && rm -rf /var/lib/apt/lists/*
COPY mighty.repos /tmp/mighty.repos
# The whole layer is keyed on /tmp/mighty.repos + HW_DEPS: editing mighty
# source never re-clones. --mount=type=ssh forwards the caller's key for
# git@gitlab.com:mit-acl/ugv/ugv_control/mpc.git; the known_hosts scan keeps
# git from prompting. No --shallow: pins are commit SHAs, and these repos are
# small.
RUN --mount=type=ssh \
    mkdir -p -m 0700 ~/.ssh && ssh-keyscan -H github.com gitlab.com >> ~/.ssh/known_hosts 2>/dev/null \
 && mkdir -p ${WS}/src \
 && python3 - "${HW_DEPS}" <<'PY' | vcs import ${WS}/src
import sys, yaml
repos = yaml.safe_load(open('/tmp/mighty.repos'))['repositories']
keep = sys.argv[1].split()
missing = [k for k in keep if k not in repos]
assert not missing, f'HW_DEPS not in mighty.repos: {missing}'
yaml.safe_dump({'repositories': {k: repos[k] for k in keep}}, sys.stdout)
PY

# ---------- deps-build: rosdep + colcon the dependency workspace ----------------
FROM ros:${ROS_DISTRO}-ros-base AS deps-build
ARG WS
SHELL ["/bin/bash", "-c"]
ENV DEBIAN_FRONTEND=noninteractive
WORKDIR ${WS}
COPY --from=deps-src ${WS}/src ${WS}/src
# --skip-keys: ament_python is mpc's buildtool_depend, not a rosdistro key;
# catkin: DecompUtil ships a catkin-era package.xml (buildtool_depend
# catkin) but is a plain CMake project — colcon builds it fine, rosdep cannot
# resolve the key. libeigen3-dev is explicit: decomp_util and mighty
# find_package(Eigen3) without declaring it.
RUN apt-get update && rosdep update \
 && rosdep install -y --ignore-src --from-paths src --skip-keys "catkin ament_python" \
 && apt-get install -y --no-install-recommends libeigen3-dev \
 && rm -rf /var/lib/apt/lists/*
# decomp_util first, on its own: decomp_rviz_plugins find_package()s it
# without declaring the dependency in package.xml, so colcon cannot order
# them in one invocation. decomp_test_node is DecompROS2's demo node: nothing
# in mighty uses it, and it includes tf2_geometry_msgs.h, which Jazzy removed.
RUN source /opt/ros/${ROS_DISTRO}/setup.bash \
 && colcon build --packages-select decomp_util --cmake-args -DCMAKE_BUILD_TYPE=Release \
 && source install/setup.bash \
 && colcon build --packages-skip decomp_util decomp_test_node --cmake-args -DCMAKE_BUILD_TYPE=Release \
 && rm -rf build log

# ---------- mighty-build: this checkout on top of the deps -----------------------
FROM deps-build AS mighty-build
ARG WS
SHELL ["/bin/bash", "-c"]
ENV DEBIAN_FRONTEND=noninteractive
WORKDIR ${WS}
# The manifest alone first, so the apt layer below is keyed on package.xml and
# a source edit re-runs only the colcon layer.
# gazebo_ros/gazebo_plugins are declared <depend>s but only the BUILD_SIMULATION
# targets use them; gazebo_msgs stays (fake_sim links it unconditionally, and it
# is messages only). nlohmann-json3-dev: find_package()ed, not declared.
COPY package.xml ${WS}/src/mighty/package.xml
RUN apt-get update && rosdep update \
 && rosdep install -y --ignore-src --from-paths src --skip-keys "catkin ament_python gazebo_ros gazebo_plugins" \
 && apt-get install -y --no-install-recommends nlohmann-json3-dev \
 && rm -rf /var/lib/apt/lists/*
# Build context = the mighty repo root (compose: context ..). What ships is
# filtered by Dockerfile.hw.dockerignore next to this file.
COPY . ${WS}/src/mighty
RUN source /opt/ros/${ROS_DISTRO}/setup.bash && source install/setup.bash \
 && colcon build --packages-select mighty \
        --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_SIMULATION=OFF -DBUILD_TESTING=OFF \
 && rm -rf build log
# Manifests for the runtime stage's rosdep, with mtimes pinned so the COPY
# --from below (and the apt layer behind it) stays cached across source edits.
RUN mkdir -p /manifests && cd src \
 && find . -name package.xml -exec cp --parents {} /manifests \; \
 && find /manifests -exec touch -d @0 {} +

# ---------- runtime: exec deps + the baked workspace -----------------------------
FROM ros:${ROS_DISTRO}-ros-base
ARG WS
SHELL ["/bin/bash", "-c"]
ENV DEBIAN_FRONTEND=noninteractive
WORKDIR ${WS}
COPY --from=mighty-build /manifests /tmp/manifests
# Exec deps come from the manifests alone. Explicit extras:
#   rmw-zenoh-cpp + zenoh-cpp-vendor  fleet RMW, PINNED to one exact apt build (below)
#   tmux                              the panes are docker execs, but handy inside
# (tf_transformations is imported only by scripts/convert_goal_to_cmd_vel.py,
# which is not an install(PROGRAMS) target and never ships — and its apt
# transforms3d breaks under numpy 2 anyway. Do not add it back blindly.)
#
# RMW PIN. Every container on a rover (drive, sensors, dlio, this one) must run the
# SAME rmw_zenoh build. Two builds that both call themselves 0.1.9 are not
# interchangeable: with dlio/drive/sensors on 0.1.9-1jammy.20260723 and this image
# on 0.1.9-1jammy.20260907 (what an unpinned install pulled on 2026-09-07),
# TRANSIENT_LOCAL subscriptions across that boundary received NOTHING while
# VOLATILE ones were fine. tf2 takes /tf_static as TRANSIENT_LOCAL, so MPC never
# saw <ns>/map -> <ns>/odom, commanded 0/0 in AUTO, and the rover sat still with a
# plan on screen (RR08, 2026-09-17). packages.ros.org keeps only the newest build
# per version, so the pin comes from the dated ROS snapshot repo instead, which is
# signed by the same ROS archive key the base image already ships in
# /usr/share/keyrings/ros2-archive-keyring.gpg.
# apt-mark hold + the dpkg-query at the end make a silent drift fail the build.
# When the fleet moves forward, bump all three ARGs together and rebuild EVERY
# rover image in the same rollout.
#
# 2026-09-19: the fleet pin moved to rmw_zenoh 0.1.9-1jammy.20260907.200640 (the
# build the C2 cart and every rover drive/sensors/dlio image now carry -- rover repo
# rover_bringup/docker/Dockerfile{,.sensors}, dlio_ws docker/Dockerfile). No
# snapshots.ros.org snapshot carries that build yet (newest is 2026-08-07 =
# 20260723), so RMW_ZENOH_CPP_VER resolves from stock packages.ros.org, which the
# base image already lists; the snapshot line below still serves the vendor pin
# (20260723.020902 is identical on both). packages.ros.org keeps only the newest
# build per version, so this exact pin stops resolving once ROS rebuilds 0.1.9 --
# the dpkg-query tripwire below fails the build loudly when that happens; move
# every fleet image together (or re-pin to a snapshot once one carries 20260907).
#
# JAZZY (the scout, pascal): pascal's host runs rmw_zenoh 0.2.8-1noble.20251007,
# a build no repo serves any more (snapshots jump from 0.2.5 to 0.2.9; stock is
# 0.2.10), so this image cannot carry the host's exact build. Pinned instead to
# the 2026-09-11 snapshot (0.2.10, == stock packages.ros.org on that date) for a
# reproducible image. Cross-build interop with pascal's host must be checked
# with a TRANSIENT_LOCAL /tf_static round trip whenever either side moves.
#
# Empty = the per-distro default chosen in the RUN below; set all three together
# to override.
ARG ROS_SNAPSHOT=
ARG RMW_ZENOH_CPP_VER=
ARG ZENOH_CPP_VENDOR_VER=
# snapshots.ros.org is signed by "ROS Snapshot builder" (AD19BAB3CBF125EA), NOT by the
# Open Robotics key in ros2-archive-keyring.gpg that packages.ros.org uses. Vendored
# here rather than pulled from a keyserver so the build needs no keyserver and cannot
# silently pick up a different key; the fingerprint assert below is the tripwire.
ARG ROS_SNAPSHOT_KEY_FPR=4B63CF8FDE49746E98FA01DDAD19BAB3CBF125EA
COPY docker/keys/ros-snapshot-archive-keyring.asc /tmp/ros-snapshot.asc
RUN case "${ROS_DISTRO}" in \
      humble) : "${ROS_SNAPSHOT:=2026-08-07}" "${RMW_ZENOH_CPP_VER:=0.1.9-1jammy.20260907.200640}" \
                "${ZENOH_CPP_VENDOR_VER:=0.1.9-1jammy.20260723.020902}" ;; \
      jazzy)  : "${ROS_SNAPSHOT:=2026-09-11}" "${RMW_ZENOH_CPP_VER:=0.2.10-1noble.20260902.013525}" \
                "${ZENOH_CPP_VENDOR_VER:=0.2.10-1noble.20260722.215006}" ;; \
      *) echo "no rmw_zenoh pin for ROS_DISTRO=${ROS_DISTRO}" >&2; exit 1 ;; \
    esac \
 && . /etc/os-release \
 && gpg --dearmor < /tmp/ros-snapshot.asc > /usr/share/keyrings/ros-snapshot-archive-keyring.gpg \
 && gpg --show-keys --with-colons /tmp/ros-snapshot.asc | awk -F: '/^fpr/{print $10; exit}' \
      | grep -qx "${ROS_SNAPSHOT_KEY_FPR}" \
 && rm -f /tmp/ros-snapshot.asc \
 && echo "deb [signed-by=/usr/share/keyrings/ros-snapshot-archive-keyring.gpg] http://snapshots.ros.org/${ROS_DISTRO}/${ROS_SNAPSHOT}/ubuntu ${VERSION_CODENAME} main" \
        > /etc/apt/sources.list.d/ros2-snapshot.list \
 && printf 'Package: ros-%s-rmw-zenoh-cpp ros-%s-zenoh-cpp-vendor\nPin: origin snapshots.ros.org\nPin-Priority: 1001\n' "${ROS_DISTRO}" "${ROS_DISTRO}" \
        > /etc/apt/preferences.d/99-rmw-zenoh-pin \
 && apt-get update && rosdep update \
 && rosdep install -y --ignore-src --dependency-types exec --from-paths /tmp/manifests \
        --skip-keys "catkin ament_python gazebo_ros gazebo_plugins" \
 && apt-get install -y --no-install-recommends \
        ros-${ROS_DISTRO}-rmw-zenoh-cpp=${RMW_ZENOH_CPP_VER} \
        ros-${ROS_DISTRO}-zenoh-cpp-vendor=${ZENOH_CPP_VENDOR_VER} \
        tmux python3-pip \
 && apt-mark hold ros-${ROS_DISTRO}-rmw-zenoh-cpp ros-${ROS_DISTRO}-zenoh-cpp-vendor \
 && test "$(dpkg-query -W -f='${Version}' ros-${ROS_DISTRO}-rmw-zenoh-cpp)" = "${RMW_ZENOH_CPP_VER}" \
 && test "$(dpkg-query -W -f='${Version}' ros-${ROS_DISTRO}-zenoh-cpp-vendor)" = "${ZENOH_CPP_VENDOR_VER}" \
 && rm -rf /var/lib/apt/lists/* /tmp/manifests
# mpc_node imports casadi/do_mpc. Pinned to what the rovers ran natively;
# numpy/scipy second so their pins win over do-mpc's resolver.
# Noble's pip refuses system-wide installs without PIP_BREAK_SYSTEM_PACKAGES
# (PEP 668); jammy's older pip ignores the variable.
ENV PIP_BREAK_SYSTEM_PACKAGES=1
# Jazzy keeps noble's apt numpy 1.26: its rosidl Python extensions are built
# against numpy 1.x, and pip cannot replace a Debian-installed numpy anyway
# ("RECORD file not found"). numpy<2 makes pip keep it instead of upgrading.
RUN if [ "${ROS_DISTRO}" = humble ]; then \
        pip3 install --no-cache-dir casadi==3.6.7 do-mpc==5.1.1 \
     && pip3 install --no-cache-dir numpy==2.2.6 scipy==1.15.3; \
    else \
        pip3 install --no-cache-dir casadi==3.6.7 do-mpc==5.1.1 scipy==1.15.3 'numpy<2'; \
    fi
COPY --from=mighty-build ${WS}/install ${WS}/install
# Interactive shells (docker exec -it ... bash) see the workspace. The panes do
# not rely on this — mighty_hw.sh sends an explicit setup line — but a human
# poking around inside should get the same environment.
RUN printf 'source /opt/ros/${ROS_DISTRO}/setup.bash\nsource %s/install/setup.bash\n' "${WS}" >> /root/.bashrc
# Command comes from compose: the container only idles (`sleep infinity`).
