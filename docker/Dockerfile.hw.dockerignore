# BuildKit per-Dockerfile ignore for Dockerfile.hw. Paths are relative to the
# build context = the mighty repo root (compose: context ..).
#
# config/ and launch/ MUST ship: CMakeLists.txt install(DIRECTORY ...) errors on
# a missing source dir, it does not skip.
.git
.vscode
.gitattributes
**/*.md
# Per-vehicle overlays are git-ignored local tuning: a clean `git status` does not
# show them, so without this a build machine's overlay would ship in the image.
config/vehicles/*.yaml
# docker/ holds the host-side tooling and the dev-only sim harness (docker/dev/sim),
# none of which belongs in the image...
docker
# ...but the vendored apt signing key must reach the build context.
!docker/keys
!docker/keys/**
**/__pycache__
**/log
