# BuildKit per-Dockerfile ignore for Dockerfile.hw. Paths are relative to the
# build context = the mighty repo root (compose: context ..).
#
# worlds/, meshes/, urdf/, config/, launch/, rviz/ MUST ship: CMakeLists.txt
# install(DIRECTORY ...) errors on a missing source dir, it does not skip.
.git
.vscode
.gitattributes
CLAUDE.md
docker
data
imgs
# benchmarking/ is 46 MB of results, but one script in it is an install(PROGRAMS)
# target, so keep just that file.
benchmarking/*
!benchmarking/unc_benchmark_node.py
**/__pycache__
**/*.ipynb
**/log
