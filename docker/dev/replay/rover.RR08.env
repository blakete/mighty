# Identity for a laptop replay of an RR08 recording: the dev stack must run under
# the RECORDING rover's name so topics and TF frames line up.
#   ROVER_ENV_FILE=$PWD/dev/replay/rover.RR08.env ./mighty_hw.sh start --dev
VEHTYPE=RR
VEHNUM=08
ROBOT_NAME=RR08
ROS_DOMAIN_ID=22
RMW_IMPLEMENTATION=rmw_zenoh_cpp
