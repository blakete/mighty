# Laptop settings for `mighty_hw.sh start --dev` (stands in for a vehicle's
# /etc/mighty/mighty.env, which install_service.sh writes). Ground robot fed by
# DLIO-named odometry, so the bag replay (replay/pass2_laptop.sh) works as-is.
MIGHTY_PLATFORM=ground_robot
MIGHTY_STATE_SOURCE=odom
MIGHTY_ODOM_TOPIC=dlio/odom_node/odom
