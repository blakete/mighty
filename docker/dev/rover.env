# Laptop identity for `mighty_hw.sh start --dev`. Stands in for the rover's
# provisioned /etc/rover/rover.env. RR99 is not a fleet name (the fleet is
# RR01..RR08) but it ends in digits like one: mighty_node takes its agent id from
# the namespace's trailing digits (or the agent_id parameter). MIGHTY's own
# settings are in dev/mighty.env.
VEHTYPE=RR
VEHNUM=99
ROBOT_NAME=RR99
ROS_DOMAIN_ID=22
RMW_IMPLEMENTATION=rmw_zenoh_cpp
