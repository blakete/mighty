# Laptop identity for `mighty_hw.sh start --dev`. Stands in for the rover's
# provisioned /etc/rover/rover.env. RR99 is not a fleet name (the fleet is
# RR01..RR08) but it must LOOK like one: mighty_node std::stoi()s the vehicle
# number out of the namespace and aborts on a non-numeric suffix.
VEHTYPE=RR
VEHNUM=99
ROBOT_NAME=RR99
ROS_DOMAIN_ID=22
RMW_IMPLEMENTATION=rmw_zenoh_cpp
