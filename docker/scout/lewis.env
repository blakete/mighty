# Identity for lewis (AgileX Scout Mini). Install as the robot's rover.env:
#   sudo install -D -m 644 docker/scout/lewis.env /etc/rover/rover.env
# mighty_hw.sh reads ROBOT_TYPE from it (unset on the Red Rovers = red_rover);
# compose loads the whole file into the hw-mighty container (env_file).
ROBOT_NAME=lewis
ROBOT_TYPE=scout
# Must match lewis's host stack (zenoh key expressions carry the domain id);
# the scout tmux session leaves ROS_DOMAIN_ID unset, i.e. 0.
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_zenoh_cpp
