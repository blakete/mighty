// Session config for the MIGHTY nodes on the scout (pascal), mounted at
// /home/swarm/config/zenoh_session_config.json5 via ROVER_CONFIG_DIR=docker/scout
// (mighty_hw.sh sets that for ROBOT_TYPE=scout). Same shape as dev/'s, but
// dialing pascal's own rmw_zenohd on :7447 (the scout tmux session's router
// pane), which pascal's sensors, DLIO and safety node also attach to with the
// stock Jazzy session config. Keys not listed here take zenoh defaults.
{
  mode: "peer",
  connect: {
    timeout_ms: { router: -1, peer: -1, client: 0 },
    endpoints: ["tcp/localhost:7447"],
    exit_on_failure: { router: false, peer: false, client: true },
  },
  listen: {
    timeout_ms: 0,
    endpoints: ["tcp/localhost:0"],
    exit_on_failure: true,
  },
  open: {
    return_conditions: { connect_scouted: true, declares: true },
  },
  scouting: {
    multicast: { enabled: false },
    gossip: {
      enabled: true,
      multihop: false,
      target: { router: ["router", "peer"], peer: ["router"] },
      autoconnect: { router: [], peer: ["router", "peer"] },
    },
  },
  timestamping: {
    enabled: { router: true, peer: true, client: true },
    drop_future_timestamp: false,
  },
  queries_default_timeout: 600000,
  routing: {
    peer: { mode: "peer_to_peer" },
  },
  transport: {
    unicast: { qos: { enabled: true } },
    link: { rx: { max_message_size: 1073741824 } },
  },
  adminspace: {
    enabled: true,
    permissions: { read: true, write: false },
  },
}
