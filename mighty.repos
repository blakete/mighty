repositories:
  # Everything the mighty package needs to build and run on hardware. The image
  # (docker/Dockerfile.hw) clones these at the pinned commits; a native build is
  #   vcs import src < src/mighty/mighty.repos
  # then rosdep + colcon from the workspace root.
  dynus_interfaces:
    type: git
    url: https://github.com/kotakondo/dynus_interfaces.git
    version: c43bcec6d4b67c6f8a8baabb1b2f8c1ba8b919d1
  # Ground-robot tracking controller (private GitLab repo: cloning needs SSH).
  mpc:
    type: git
    url: git@gitlab.com:mit-acl/ugv/ugv_control/mpc.git
    version: 193c36bf7d78e7e10e493f9db38c31c6d84122b4
  # Only decomp_util and decomp_ros_msgs are used; the image deletes the repo's
  # decomp_rviz_plugins and decomp_test_node packages after cloning.
  DecompROS2:
    type: git
    url: https://github.com/kotakondo/DecompROS2.git
    version: a2bc42ed46bf934323994706f17af8a3883860ea
