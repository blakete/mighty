<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mighty</name>
  <version>0.0.0</version>
  <description>MIGHTY: Hermite spline-based Efficient Trajectory Planning</description>
  <maintainer email="kkondo@mit.edu">Kota Kondo</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>dynus_interfaces</depend>
  <depend>decomp_util</depend>
  <depend>decomp_ros_msgs</depend>
  <depend>eigen</depend>
  <!-- PCL: headers and pcl_conversions (header-only here) at build time; at run
       time the binary links only libpcl_common and libpcl_kdtree. Declaring the
       -dev packages as run dependencies pulled VTK, Qt5, a JDK and GDAL into the
       image (~2.3 GB) for nothing. -->
  <build_depend>libpcl-all-dev</build_depend>
  <build_depend>pcl_conversions</build_depend>
  <exec_depend>libpcl-common</exec_depend>
  <exec_depend>libpcl-kdtree</exec_depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>message_filters</depend>

  <!-- Runtime: the ground-robot tracking controller, and what the launch file
       and the Python scripts import. -->
  <exec_depend>mpc</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
